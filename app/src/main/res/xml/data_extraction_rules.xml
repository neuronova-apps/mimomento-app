<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="file" path="progress_events.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="journal_entries.json" />
        <exclude domain="file" path="journal_entries.json.bak" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="file" path="progress_events.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="journal_entries.json" />
        <exclude domain="file" path="journal_entries.json.bak" />
    </device-transfer>
</data-extraction-rules>
